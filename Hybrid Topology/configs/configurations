##VLAN CONFIGURATION
1.VLAN 10(COMPUTERS)
2.VLAN 30(SERVERS)

COMPUTERS:
Network:192.168.10.1/64
gateway:192.168.10.1(Router1) ,192.168.10.2(router2) BACKUP
SERVERS:
Network:192.168.30.1/64
gateway:192.168.30.1(Router1) ,192.168.30.2(router2) BACKUP

##SWITCH VLAN CONFIGURATION
create VLans 10,30
Trunk ports to router
Trunk port access switch
Trunk port betweeen the Dist-switch 1 and 2

##router congiguration
! VLAN10 interface
interface GigabiEthernet0/0
ip address 192.168.10.1 255.255.255.255.0
no shutdown
! VLAN30 interface
interface GigabitEthernet0/1
ip address 192.168.30.1 255.255.255.0
no shutdown
##switch configuration
! create vlans
vlan 10
name computers
vlan 30
name servers
!Trunk to router
interface GigabitEthernet0/1
switchport mode trunk
switchport allowed 10,30
no shutdown
 
##ACL(ACCESS CONTROL LIST)
! Allow VLAN 10 to access VLAN 30 servers
access-list 101 permit ip 192.168.10.0 0.0.0.255 192.168.30.0 0.0.0.255

! Apply to router interface
interface GigabitEthernet0/0
 ip access-group 101 in
!Trunk on Acc-switches
Interface range FastEthernet0/1-6
switchport mode trunk
switchport trunk allowed vlan 10,30
no shutdown



